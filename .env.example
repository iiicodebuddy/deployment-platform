
# Database name used by the application
MYSQL_DATABASE=app_db

# Public URL for the web application
MYSQL_PUBLIC_URL=http://localhost:8000

# Root password for MySQL (use a strong password in production)
MYSQL_ROOT_PASSWORD=secret_root_password

# Full MySQL connection URL used by some services or libraries
MYSQL_URL=mysql://root:secret_root_password@127.0.0.1:3306/app_db

# The default URI used to generate URLs in a non-HTTP context.
DEFAULT_URI=http://localhost

# Mailer configuration
MAILER_DSN=null://null

# Messenger configuration
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Database connection URL
DATABASE_URL=mysql://root:secret_root_password@127.0.0.1:3306/app_db

# Alternative / legacy environment variables for MySQL configuration
MYSQLDATABASE=app_db
MYSQLHOST=127.0.0.1
MYSQLPASSWORD=secret_root_password
MYSQLPORT=3306
MYSQLUSER=root